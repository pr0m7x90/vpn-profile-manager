#!/usr/bin/env bash
set -u

CONFIG_DIR="${VPNPM_CONFIG_DIR:-/etc/vpn-profile-manager}"
RUN_DIR="${VPNPM_RUN_DIR:-/run/vpn-profile-manager}"
PROFILE_DIR="$CONFIG_DIR/profiles"

[[ $# -eq 1 ]] || { echo "Usage: sudo disconnect <profile-alias>"; exit 1; }
[[ $EUID -eq 0 ]] || { echo "[!] Run this command with sudo."; exit 1; }

alias_name="$1"
profile="$PROFILE_DIR/$alias_name"
[[ -d "$profile" ]] || { echo "[!] Profile '$alias_name' does not exist."; exit 1; }

vpn_name="$(cat "$profile/name" 2>/dev/null || echo "$alias_name")"
pid_file="$RUN_DIR/$alias_name.pid"

if [[ -f "$pid_file" ]]; then
    pid="$(cat "$pid_file")"

    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid"
        sleep 2
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
        echo "[+] $vpn_name disconnected."
    else
        echo "[!] VPN process was already stopped."
    fi

    rm -f "$pid_file"
    exit 0
fi

if pgrep -x openvpn >/dev/null 2>&1; then
    echo "[!] No PID file found for '$alias_name'."
    echo "[!] Refusing to kill an unrelated OpenVPN process."
    exit 1
fi

echo "[!] $vpn_name is not running."
