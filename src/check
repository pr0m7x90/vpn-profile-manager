#!/usr/bin/env bash
set -u

CONFIG_DIR="${VPNPM_CONFIG_DIR:-/etc/vpn-profile-manager}"
PROFILE_DIR="$CONFIG_DIR/profiles"

[[ $# -eq 1 ]] || { echo "Usage: check <profile-alias>"; exit 1; }

alias_name="$1"
profile="$PROFILE_DIR/$alias_name"
[[ -d "$profile" ]] || { echo "[!] Profile '$alias_name' does not exist."; exit 1; }

vpn_name="$(cat "$profile/name" 2>/dev/null || echo "$alias_name")"

echo
echo "================================"
echo "       $vpn_name VPN Status"
echo "================================"

if pgrep -x openvpn >/dev/null 2>&1; then
    echo "[+] OpenVPN process: RUNNING"
else
    echo "[-] OpenVPN process: NOT RUNNING"
fi

if ip link show tun0 >/dev/null 2>&1; then
    echo "[+] VPN interface:    tun0 UP"
    vpn_ip="$(ip -4 addr show tun0 | awk '/inet / {print $2}' | head -n 1)"
    [[ -n "$vpn_ip" ]] && echo "[+] VPN IP:            $vpn_ip"
else
    echo "[-] VPN interface:    tun0 NOT FOUND"
fi

echo
echo "[*] VPN routes:"
ip route | grep tun0 || echo "[-] No tun0 routes found."

echo
echo "[*] Internet:"
if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
    echo "[+] Internet:           OK"
else
    echo "[-] Internet:           FAILED"
fi

echo
echo "================================"
